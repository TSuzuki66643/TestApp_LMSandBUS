<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<log4net>
		<appender name="tryLogAppender" type="log4net.Appender.RollingFileAppender" >
			<File value=".\log\" />
			<DatePattern value='yyyyMMdd".log"' />
			<StaticLogFileName value="false" />
			<RollingStyle value="date" />
			<AppendToFile value="true" />
			<MaximumFileSize value="100MB" />
			<MaxSizeRollBackups value="30" />
			<layout type="log4net.Layout.PatternLayout">
				<ConversionPattern value="%date [%thread] [%-5level] (%method) - %message%n" />
			</layout>
		</appender>
		<filter type="log4net.Filter.LevelRangeFilter">
			<LevelMax value="FATAL" />
			<LevelMin value="DEBUG" />
		</filter>
		<root>
			<level value="Debug" />
			<appender-ref ref="tryLogAppender" />
		</root>

		<appender name="PowerStatus" type="log4net.Appender.RollingFileAppender">
			<file value="log/power.log" />
			<appendToFile value="true" />
			<layout type="log4net.Layout.PatternLayout">
				<conversionPattern value="%date [%thread] %-5level - %message%newline" />
			</layout>
		</appender>

		<!-- ★特定のログ用のロガー設定 -->
		<!-- additivity="false" にすることで、通常のログファイルへの重複書き込みを防ぎます -->

		<logger name="PowerStatusLogger" additivity="false">
			<level value="DEBUG" />
			<appender-ref ref="PowerStatus" />
		</logger>

		<root>
			<level value="DEBUG" />
			<appender-ref ref="RollingFileAppender" />
		</root>
	</log4net>
</configuration>